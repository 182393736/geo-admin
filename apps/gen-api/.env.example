# gen-api 运行环境（复制为 .env 后按需修改）
# 域名只改这里，部署命令不变：docker compose up -d --build

# 对外 API 域名（文档用；实际监听见 API_PORT）
# 例：https://test-gen-api.hanyuai.com 或生产域名
PUBLIC_API_URL=https://test-gen-api.hanyuai.com
API_PORT=6001

# Mongo：默认用 compose 内 mongo；外置库时改成连接串并删掉 mongo 服务依赖
MONGO_URL=mongodb://mongo:27017/geo

JWT_SECRET=change-me
COLLECTOR_API_KEY=change-me-collector-key

LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# LLM_PROXY=
# BOCHA_API_KEY=
# TAVILY_API_KEY=
