# 官网 Docker 构建 / 运行参数（复制为 .env）
# 命令始终：docker compose up -d --build

SITE_PORT=6003

# 浏览器请求走同域 /geo-api（由 Nuxt 容器反代到宿主机 API）
NUXT_PUBLIC_API_BASE=/geo-api
# 容器内访问宿主机 gen-api（docker compose 已加 host.docker.internal）
NUXT_GEO_API_TARGET=http://host.docker.internal:6001

NUXT_PUBLIC_CONSOLE_URL=https://test-gen-user-dash.hanyuai.com
