# geo-api 运行环境（复制为 .env 后按需修改）
# 本地默认本机端口；勿填测试服

PUBLIC_API_URL=http://127.0.0.1:6001
API_PORT=6001

# Mongo：本地可用 mongodb://127.0.0.1:27017/geo 或 dev:all 的 6007
MONGO_URL=mongodb://127.0.0.1:27017/geo

JWT_SECRET=change-me
COLLECTOR_API_KEY=change-me-collector-key

# 微信公众号（消息推送 / 扫码登录）
# Token 与公众号后台「服务器配置」一致；回调 URL：https://geo-api.hanyuai.com/user/wx/callback
WX_MP_APPID=
WX_MP_SECRET=
WX_MP_TOKEN=geo_wx_token
# WX_MP_REPLY_LOGIN=登录成功，请回网页继续

LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# LLM_PROXY=
# BOCHA_API_KEY=
# TAVILY_API_KEY=
