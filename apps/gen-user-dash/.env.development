# 是否使用 mock 数据（false=联调真实后端；true=纯前端演示）
# 现在三个鉴权接口已通，dev 关闭 mock
VITE_USE_MOCK=false

# 置空 = 请求走相对路径 → vite dev proxy 自动转发到 http://127.0.0.1:6001
# 测试环境请用 https://test-gen-api.hanyuai.com（见 docs/domains.md）
VITE_API_BASE=
VITE_ARTICLE_BASE=

# 官网 / 首登分析站（apps/gen-user-site，Nuxt）地址：
#  - 本地：http://localhost:6003
#  - 测试环境：https://test-gen-user-site.hanyuai.com
# 用户后台无品牌时统一整页跳转到该站 /trial，不再自建 /trial 页。
VITE_SITE_URL=http://localhost:6003
