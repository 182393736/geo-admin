# 是否使用 mock 数据（false=联调真实后端；true=纯前端演示）
# 现在三个鉴权接口已通，dev 关闭 mock
VITE_USE_MOCK=false

# 置空 = 请求走相对路径 → vite dev proxy 自动转发到 http://127.0.0.1:7001
# 不要填线上域名（geoapi.timus.cn / geoarticle.timus.cn），避免误发真实请求
VITE_API_BASE=
VITE_ARTICLE_BASE=

# 官网 / 首登分析站（apps/gen-user-site，Nuxt）地址：
#  - dev：两站分端口，填 Nuxt dev 地址 http://localhost:3002
#  - 生产同域（geo.timus.cn 下 /trial 与 /dashboard 同源）：置空即可
# 用户后台无品牌时统一整页跳转到该站 /trial，不再自建 /trial 页。
VITE_SITE_URL=http://localhost:3002
