# 是否使用 mock 数据（false=联调真实后端；true=纯前端演示）
VITE_USE_MOCK=false

# dev 置空 → 走 vite proxy（/user、/api → http://127.0.0.1:7001）
# 生产发布时按需填后端网关域名（或在 nginx 侧反代后同样置空）
VITE_API_BASE=
VITE_ARTICLE_BASE=

# 官网 / 首登分析站（apps/gen-user-site，Nuxt）地址：
# dev 分端口填 http://localhost:3002；生产同域置空（默认相对路径 /trial）
VITE_SITE_URL=
