{
  "name": "@geo-admin/gen-caiji",
  "version": "0.1.0",
  "private": true,
  "description": "采集应用：Electron + Element Plus，IP 列表 + 每 IP 独立浏览器会话 + 5 平台标签页",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host\" \"wait-on http-get://127.0.0.1:6006 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:6006 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "element-plus": "^2.14.0",
    "sharp": "^0.35.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "playwright": "^1.63.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.0"
  }
}
