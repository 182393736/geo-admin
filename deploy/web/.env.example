# 生产默认值已写在 docker-compose.yml，一般无需本文件。
#
# 同域方案①：官网与用户后台共用 geo.hanyuai.com
# （Nginx 路径分流见 deploy/nginx/geo-same-origin.conf）

NUXT_PUBLIC_SITE_URL=https://geo.hanyuai.com
NUXT_PUBLIC_CONSOLE_URL=https://geo.hanyuai.com
VITE_SITE_URL=https://geo.hanyuai.com
NUXT_API_BASE=https://geo-site-api.hanyuai.com
NUXT_PUBLIC_API_BASE=https://geo-site-api.hanyuai.com
NUXT_GEO_API_TARGET=https://geo-api.hanyuai.com
VITE_API_BASE=https://geo-api.hanyuai.com
VITE_ARTICLE_BASE=https://geo-api.hanyuai.com
NUXT_PUBLIC_GEO_API_BASE=/geo-api
SITE_WEB_PORT=5003
DASH_PORT=5180
