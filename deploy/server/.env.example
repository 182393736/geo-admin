# 复制：cp .env.example .env

# 对外 API 地址（写进 geo-api）
PUBLIC_API_URL=https://geo-api.hanyuai.com
API_PORT=6001
CMS_PORT=5001

# Mongo：宿主机已有 Mongo 时用 host.docker.internal
# 若 Mongo 在另一台机器，改成真实连接串
MONGO_URL=mongodb://host.docker.internal:27017/geo
MONGODB_URL=mongodb://host.docker.internal:27017/site_manage

# 密钥（务必改掉）
JWT_SECRET=change-me-in-prod
COLLECTOR_API_KEY=change-me-collector-key

# LLM（按需）
LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
