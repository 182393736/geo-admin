# 生产默认值已写在 docker-compose.yml，一般无需本文件。
# 若要覆盖，复制为 .env 后修改（.env 不提交）。
#
# server 容器使用 network_mode: host，Mongo 请指向本机回环：

PUBLIC_API_URL=https://geo-api.hanyuai.com
MONGO_URL=mongodb://127.0.0.1:27017/geo
MONGODB_URL=mongodb://127.0.0.1:27017/site_manage
JWT_SECRET=geo-prod-jwt-7f3a9c2e1b8d4e6f0a5c9d2e8b1f4a7c
COLLECTOR_API_KEY=geo-prod-collector-3e9b1c7a5d2f8e4b0a6c9d1e7f2a5b8c
# 必须 deepseek；勿设 siliconflow（内置硅基 key 已失效会 401）
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY 默认走代码内置；若要覆盖再取消注释
# DEEPSEEK_API_KEY=
